<div class="row">
	<div class="col">
		<div class="widget-container boxed">
            <div class="inner">
                <div class="navbar-header">
                    <h3>Collectors</h3>
                </div>
                <div class="navbar-collapse" id="nav-items" style="align-self: center;">
                    <ul class="nav navbar-nav navbar-right">
                        <li>
                            <a class="navbar-item" style="color: black; border: 1px solid #a6a6a6" href="https://polidashboard.statuspage.io/" target="_blank"><i class="fa-solid fa-up-right-from-square"></i>&nbsp; <span>View Data Collection Overtime</span></a>
                        </li>
                    </ul>
                </div>
                <hr style="margin: 8px;">
                <table id="collector-table">
                    <thead>
                        <tr>
                            <th>Country</th>
                            <th>Total Ads to Date</th>
                            <th>Most Recent Timestamp</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody></tbody>
                </table>
            </div>
        </div>
	</div>
</div>

<script type="text/javascript">

countries = <%- JSON.stringify(countries) %>

countries.forEach(c => {
    var row = d3.select('#collector-table tbody')
        .append('tr')
    
    row.append('td')
        .text(c.name)

    row.append('td').classed('loading-cell', true).append('div').classed('status-loader', true);
    row.append('td').classed('loading-cell', true).append('div').classed('status-loader', true);
    row.append('td').classed('loading-cell', true).append('div').classed('status-loader', true).style('width', '24px');


    $.post('/status/country', { country: c.code })
        .done(data => {
            var totalAds = data && data.total_ads !== undefined ? data.total_ads : '-';
            var timestamp = data && data.timestamp ? data.timestamp : '-';

            row.html('');
            row.append('td').text(c.name);
            row.append('td').text(totalAds);
            row.append('td').text(timestamp);

            var status = "Unable to fetch data...";
            var statusClass = "";

            if (timestamp !== '-') {
                var now = moment();
                var last = moment(timestamp);
                status = now.diff(last, 'hours') > 24 ? 'Down' : 'Up';
                statusClass = status;
            } else {
                statusClass = "Error";
            }

            row.append('td')
                .text(status)
                .attr('class', statusClass);
        })
        .fail((jqXHR, textStatus, errorThrown) => {
            row.html('');
            row.append('td').text(c.name);
            row.append('td').text('-');
            row.append('td').text('-');
            row.append('td')
                .text("Unable to fetch data...")
                .attr('class', "Error");

        });

})
</script>

<style>
    /* HTML: <div class="loader"></div> */
    .status-loader {
        border-radius: 5px;
        width: 60px;
        height: 11px;
        background: 
            linear-gradient(90deg,#0001 33%,#0005 50%,#0001 66%)
            #f2f2f2;
        background-size:300% 100%;
        animation: l1 1s infinite linear;
    }
    @keyframes l1 {
        0% {background-position: right}
    }

    .loading-cell {
        justify-items: right;
        padding: 0;
    }
</style>