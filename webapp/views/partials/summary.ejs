	function drawPages(data, anchor, pagesToShow=3) {
		d3.select('#funder_pages_loader').style('display', 'none');
		if (data.length == 0) {
			d3.select(anchor)
				.html("")
				.append('h3')
				.style('margin', '13px 20px')
				.html('No Pages Found');
			return;
		}

		// Create the container for the page widget
		d3.select('#summary-stats')
			.style('border', '1px solid rgb(137 137 137)')
			.style('border-radius', '5px')
			.style('padding', '5px')
			.style('margin', '0px')
			.style('margin-bottom', '5px')
		
		d3.select('#total_ads')
			.html(function () {
				var grandTotal = d3.sum(data, function (d) { return d.page_ad_count; });
				return `${grandTotal}`;
			})
		
		d3.select('#total_spend')
			.html(function () {
				var spendMinTotal = d3.sum(data, function (d) { return d.spend_lower_bound; });
				var spendMaxTotal = d3.sum(data, function (d) { return d.spend_upper_bound; });
				return `${formatBound(spendMinTotal, true)} - ${formatBound(spendMaxTotal, true)}`;
			})
		
		d3.select('#total_impressions')
			.html(function () {
				var impressionsTotal = d3.sum(data, function (d) { return d.impressions_lower_bound; });
				return `${formatBound(impressionsTotal)}+`;
			})
		
		d3.selectAll('.summary-info').style('display', 'inline');
		d3.selectAll('.lds-ellipsis').style('display', 'none');

		var pageContainers = null

		if (data.length > 1) {
			d3.select(anchor) // Add a summary
				.html("")

			// Add title and horizontal line
			d3.select('#funder_pages').append('h3').style('margin', '13px 20px').html('Filter Results By (Select an option from the list below.)');
			d3.select('#funder_pages').append('div').style('place-items', 'center').append('hr').style('border', '1px solid lightgrey').style('margin-bottom', '0').style('width', '92%');
			
			var allContainer = d3.select('#funder_pages').append('div').attr('class', 'page-container').style('padding', 0);

			allContainer.append('label')
				.attr('class', 'page-left funder-radio-container page-filter-button')
				.style("type", "radio")
				.append('input')
					.attr('id', 'all-radio-button')
					.attr('type', 'radio')
					.attr('name', 'filter')  // Use name attribute to make it a true radio button group
					.attr('class', 'funder-radio')
					.style('background-color', '#006ebe')
					.on('click', function () {
						revertPage();
						d3.select(this).style('background-color', '#006ebe');
					});

			allContainer.append('div')
				.attr('class', 'page-right')
				.style('display', 'flex')
				.style('align-items', 'center')
				.html(`<h3 style='margin: 0;'>All Pages (Default)</h3>`);
			
			// Define the page containers to hold the facebook pages
			pageContainers = d3.select(anchor)
				.selectAll('pageContainers')
				.data(data.slice(0, pagesToShow))
				.enter()
				.append('div')
					.attr('class', 'page-container')
			
			// Create the left column (with the radio button)
			var pageLefts = pageContainers.append('label')
