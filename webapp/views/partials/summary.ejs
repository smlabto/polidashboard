	function drawTimeline(data, pageId = null) {
		// Draw the funder's ad timeline
		d3.select('#timeline_loader').style('display', 'none');

		// Get the start and end dates
		const start = moment(fbStartDay, 'MM-DD-YYYY').startOf('day').toDate();
		const end = moment(fbEndDay, 'MM-DD-YYYY').startOf('day').toDate();

		const rows = [
			['date'],
			[currencySymbol + '0 - ' + currencySymbol + '99'],
			[currencySymbol + '100 - ' + currencySymbol + '499'],
			[currencySymbol + '500 - ' + currencySymbol + '999'],
			[currencySymbol + '1000 - ' + currencySymbol + '4999'],
			[currencySymbol + '5000+']
		];

		// Create a map for quick date lookup
		const dateMap = new Map();
		for (
			let day = new Date(Date.UTC(start.getUTCFullYear(), start.getUTCMonth(), start.getUTCDate()));
			day <= end;
			day.setUTCDate(day.getUTCDate() + 1)
		) {
			day.setUTCHours(0, 0, 0, 0);
			const timestamp = day.getTime();
			dateMap.set(timestamp, rows[0].length);
			rows[0].push(timestamp);
			for (let r = 1; r < rows.length; r++) {
				rows[r].push(0);
			}
		}

		// Helper function to determine the spending range label
		function timelineRangeToLabel(d) {
			if (d.spend_upper_bound < 100) {
				return currencySymbol + '0 - ' + currencySymbol + '99';
			} else if (d.spend_upper_bound < 500) {
				return currencySymbol + '100 - ' + currencySymbol + '499';
			} else if (d.spend_upper_bound < 1000) {
				return currencySymbol + '500 - ' + currencySymbol + '999';
			} else if (d.spend_upper_bound < 5000) {
				return currencySymbol + '1000 - ' + currencySymbol + '4999';
			} else {
				return currencySymbol + '5000+';
			}
		}

		// Fill rows based on data
		data.forEach(ad => {
			const row = rows.map(el => el[0]).indexOf(timelineRangeToLabel(ad));
			const startTime = Date.parse(ad.delivery_start_time);
			const stopTime = Date.parse(ad.delivery_stop_time);

			dateMap.forEach((index, timestamp) => {
				if (timestamp + 86400000 >= startTime && timestamp <= stopTime) {
					rows[row][index]++;
				}
			});
		});

		function adjustAndRedrawChart() {
			// Remove the old chart and redraw
			d3.select('#timeline').selectAll('*').remove();

			// Calculate the current chart width
			const chartWidth = document.getElementById('timeline').offsetWidth;

			const minWidthCheck = 480;
			const bottomPadding = chartWidth <= minWidthCheck ? 40 : 5; // Adjust padding based on the chart width

			// Create the new chart
			const chart = c3.generate({
				data: {
					x: 'date',
					columns: rows,
					type: 'bar',
					order: null
				},
				axis: {
					x: {
						type: 'timeseries',
						tick: {
							format: function (x) {
								return d3.utcFormat('%m/%d/%y')(x);
							},
							culling: true
						},
						padding: {
							right: 0,
							left: 0
						},
						label: {
							text: 'Ads Spending Range (by Date MM/DD/YY)',
							position: 'outer-center'
						}
					},
					y: {
						tick: {
							count: 4,
							format: d3.format('d')
						},
						min: 0,
						padding: {
							bottom: 0
						},
						label: {
							text: 'Number of Ads',
							position: 'outer-middle'
						}
					}
				},
				legend: {
					item: {
						onclick: function () {}
					}
				},
				bindto: '#timeline',
				size: {
					height: 200
				},
				padding: {
					right: 35,
					bottom: bottomPadding // Apply adjusted padding
				}
			});

			// Apply the first group elements
			const firstElements = rows.map(row => row[0]).slice(1);
			chart.groups([firstElements]);

			// Adjust axis tick labels after chart is drawn
			const chartSvg = d3.select('#timeline svg');
			const xAxisTicks = chartSvg.selectAll('.c3-axis-x .tick text');
			const xAxisLabel = chartSvg.selectAll('.c3-axis-x-label');

			// If the width is 400px or less, slant the text
			if (chartWidth <= minWidthCheck) {
				// Apply rotation and move labels
				xAxisTicks.style('transform', 'rotate(-45deg) translate(-23px, 3px)');
				xAxisLabel.style('transform', 'translate(0, 33px)');
			} else {
				xAxisTicks.style('transform', 'rotate(0deg)');
			}

			chartSvg.node().offsetHeight;
		}

		window.addEventListener('resize', function () {
			adjustAndRedrawChart(); // Redraw chart on resize
		});

		// Initial call on page load
		adjustAndRedrawChart();
	}

	function drawDemographics(data) {
		// Create the targetted demographics chart
		// Clear existing chart if there is one
		var container = d3.select("#demographics")
		container.html("")

		// Get the chart dimensions
		var margin = {top: 10, right: 30, bottom: 40, left: 70}
		var width = container.node().getBoundingClientRect().width - margin.left - margin.right
		var height = 400 - margin.top - margin.bottom
		
		// Create the drawing space
		var svg = container
			.append("svg")
				.attr("width", width + margin.left + margin.right)
				.attr("height", height + margin.top + margin.bottom)
				.attr("id", "main-demographics-svg")
			.append("g")
				.attr("transform",
					"translate(" + margin.left + "," + margin.top + ")");

		// Create x axis
		var x = d3.scaleLinear()
			.domain([0, 1])
			.range([ 0, width ]);

		svg.append("g")
			.attr("transform", "translate(0," + height + ")")
			.call(
				d3.axisBottom(x)
					.tickFormat(d3.format('.0%'))
			);

		svg.append("text")
			.attr("transform", "translate(" + (width / 2) + " ," + (height + margin.top + 20) + ")")
			.style("text-anchor", "middle")
			.text("Audience Demographics (in %)");

		// var yDomain = ['M 13-17', 'W 13-17', 'M 18-24', 'W 18-24', 'M 25-34', 'W 25-34', 'M 35-44', 'W 35-44', 'M 45-54', 'W 45-54', 'M 55-64', 'W 55-64', 'M 65+', 'W 65+', '? 18-65+', '']
		var yDomain = ['M 13-17', 'M 18-24', 'M 25-34', 'M 35-44', 'M 45-54', 'M 55-64', 'M 65+','W 13-27', 'W 18-24', 'W 25-34', 'W 35-44', 'W 45-54', 'W 55-64', 'W 65+', '? 18-65+', '']
		// Used to determine the color of the dots
		var color = function(d) {
			if (d.demographic[0] == 'M') return colorSchemes.blue
			if (d.demographic[0] == 'W') return colorSchemes.green
			return '#F0A202'
		}

		// Clean the data for use in the chart
		var cleanedData = [] // The cleaned data will be a list of objects corresponding to each dot
		var genders = ['female', 'male', 'unknown']
		currentAd = data[0].ad
		var unknownPercent = 0.0;
		var foundDemos = []
		for (var i = 0; i < data.length; i++) {
			if (data[i].ad != currentAd) {
				cleanedData.push({
					demographic: '? 18-65+',
					percentage: unknownPercent,
					ad: data[i].ad,
					title: data[i].title,
					url: `https://www.facebook.com/ads/library/?id=${data[i].ad}`,
					spend: rangeToLabel(data[i]),
					impressions: rangeToLabel(data[i], "impressions")
				})
				foundDemos.push('? 18-65+')
				// If some demographics are missing for points we already plotted, then default them to 0
				for (var j = 0; j < yDomain.length-1; j++) {
					if (!foundDemos.includes(yDomain[j])) {
						cleanedData.push({
							demographic: yDomain[j],
							percentage: 0,
							ad: data[i].ad,
							url: `https://www.facebook.com/ads/library/?id=${data[i].ad}`,
							spend: rangeToLabel(data[i]),
							impressions: rangeToLabel(data[i], "impressions")
						})
					}
				}

				currentAd = data[i].ad
				unknownPercent = 0.0;
			}
			
			if (data[i].gender === 'unknown') {
				unknownPercent += parseFloat(data[i].percentage);
			} else {
				let demo = data[i].gender.charAt(0).toUpperCase() + ' ' + data[i].age_range;
				if (demo.charAt(0) === 'F') {
					demo = 'W' + demo.slice(1);
				}
				if (yDomain.includes(demo)) {
					cleanedData.push({
						demographic: demo,
						percentage: data[i].percentage,
						ad: data[i].ad,
						url: `https://www.facebook.com/ads/library/?id=${data[i].ad}`,
						spend: rangeToLabel(data[i]),
						impressions: rangeToLabel(data[i], "impressions")
					})

					foundDemos.push(demo)
				} else {
					console.log("NOT IN DOMAIN")
				}
			}
				
			
		}

		// Calculate y-coordinates of each row
		var yRange = []
		for (var i = 0; i < yDomain.length; i++) {
			yRange.push(height * i / (yDomain.length - 1))
		}

		// Create y-axis
		var y = d3.scaleOrdinal()
			.domain(yDomain)
			.range(yRange)
		svg.append("g")
			.call(d3.axisLeft(y));

		svg.append("text")
			.attr("transform", "rotate(-90)")
			.attr("y", 0 - margin.left)
			.attr("x", 0 - (height / 2))
			.attr("dy", "1em")
			.style("text-anchor", "middle")
			.text("Gender and Age");

		var defaultRadius = 3

		var tooltip = container.append("div")
			.attr("class", "maptip")
			.attr("state", "None")
			.attr("percent", "None")
			.style("position", "absolute")
			.style("visibility", "hidden")
			.style("z-index", 100)
			.style("background", "#000000d1")
			.style("width", "200px")
			.style("text-align", "left");

		// Function to be called when you mouseover a dot
		var highlight = function(d) {

			d3.selectAll('.ad_'+d.ad)
				.transition()
				.duration(50)
				.attr('r', 6)
				.style('opacity', 1)
				.style('fill', "black")
		}

		var highlightTooltip = function(d) {
			
			var tooltipText = `
				<p style="margin-bottom: 5px"><span class="tip-yellow">${d3.format(".1%")(d.percentage)}</span> of the audience for this ad are <span class="tip-yellow">${d.demographic}</span></p>
				<p style="margin-bottom: 5px">The ad had <span class="tip-yellow">${d.impressions}</span> impressions and cost somewhere between <span class="tip-yellow">${d.spend}</span></p>
				<p style="margin-bottom: 5px">Click the dot to see the ad.</p>
			`;

			var coords = d3.mouse(this);

			// Calculate tooltip position based on the mouse position
			var xPos = coords[0] + 100; // Adjust the offset as needed
			var yPos = coords[1] - 20;

			var parentElement = document.getElementById("demographics-dropdown");
			var childElement = document.getElementById("demographics");

			// Get the bounding rectangles of both elements
			var parentRect = parentElement.getBoundingClientRect();
			var childRect = childElement.getBoundingClientRect();

			// Calculate the offset of the child element relative to its parent
			var offsetX = childRect.left - parentRect.left;
			var offsetY = childRect.top - parentRect.top;

			tooltip.html(tooltipText)
				.style("left", (xPos + offsetX) + "px")     
				.style("top", (yPos + offsetY) + "px")
				.style('visibility', 'visible');
		}

		// Function to be called when you mouse out of a dot
		var selected_dot = null;

		var doNotHighlight = function(d) {
			d3.selectAll('.demo_dot')
				.transition()
				.duration(200)
				.attr('r', defaultRadius)
				.style('opacity', 0.2)
				.style('fill', color)
			
			tooltip.style('visibility', 'hidden');
		}

		// Function to be called when you click a dot
		var viewAd = function(d) {

			// Draw horizontal bars for the same ad
			var sameAdData = cleanedData.filter(item => item.ad === d.ad);
			var barHeight = 20;
			var barPadding = 2;
			
			
			svg.selectAll(".ad-bar").remove();
			svg.selectAll(".ad-bar-label").remove();

			if (boxplot_check) {
				horizLines.transition().duration(500).style('opacity', '0');
				boxes.transition().duration(500).style('opacity', '0');
				medianLines.transition().duration(500).style('opacity', '0');
			}
			

			svg.selectAll(".ad-bar")
				.data(sameAdData)
				.enter()
				.append("rect")
				.attr("class", "ad-bar")
				.attr("x", x(0))
				.attr("y", function(item) { return y(item.demographic) - barHeight / 2; })
				.attr("width", 0) // Start with width 0 for transition
				.attr("height", barHeight)
				.attr("fill", function(item) {
					if (item.demographic[0] === 'M') return colorSchemes.blue;
					if (item.demographic[0] === 'W') return colorSchemes.green;
					return '#F0A202';
				})
				.attr("opacity", 1)
				.lower() // Ensure bars are drawn below other elements
				.transition() // Add transition
				.duration(500) // Duration of the transition
				.attr("width", function(item) { return x(item.percentage); });

			// Add percentage labels beside each bar
			svg.selectAll(".ad-bar-label")
				.data(sameAdData)
				.enter()
				.append("text")
				.attr("class", "ad-bar-label")
				.attr("x", 0)// Position label 5px to the right of the bar
				.attr("y", function(item) { return y(item.demographic); })
				.attr("dy", ".35em")
				.text(function(item) { return d3.format(".1%")(item.percentage); })
				.style("fill", "black")
				.style("font-size", "12px")
				.attr("opacity", 0)
				.transition() // Add transition
				.duration(500)
				.attr("opacity", 1)
				.attr("x", function(item) { return x(item.percentage) + 5; })
				

			// Update the ad_name_replace element with d.ad
			document.getElementById('ad_name_replace').innerHTML = `<span style="font-style: normal; font-size:14px; display: inline-block; min-height:16px; color:black; background: #fff651;">Demographic stats for <b><a href="${d.url}" target="_blank">the selected ad <i class="fas fa-external-link"></i></a></b> from '${mainFunder}'</span>`;
			document.querySelector('.demo_ad_exit_button').style.display = 'block';
			document.querySelector('#demo-switch').style.pointerEvents = 'none';
			document.querySelector('#demo-switch').style.opacity = 0.5;

			svg.selectAll('.demo_dot')
				.on("mouseenter", null)
				.on("mouseover", null)
				.on("mouseout", null);
			
			svg.selectAll('.demo_dot')
				.transition()  // Start a transition
				.duration(500)
				.style('opacity', 0)
				.style('pointer-events', 'none')
				.attr('r', 3)
				.style('fill', color)


			tooltip.style('visibility', 'hidden');
		}

		// Attach function to demo_ad_exit_button
		document.querySelector('.demo_ad_exit_button').onclick = null; // Clear previous function
		document.querySelector('.demo_ad_exit_button').addEventListener('click', function() {
			if (boxplot_check) {
				horizLines.transition().duration(500).style('opacity', '1');
				boxes.transition().duration(500).style('opacity', '1');
				medianLines.transition().duration(500).style('opacity', '1');
			}
			// Shrink the bars
			svg.selectAll(".ad-bar")
				.transition()
				.duration(500)
				.attr("width", 0)
				.remove();

			// Remove the labels alongside the bars
			svg.selectAll(".ad-bar-label")
				.transition()
				.duration(500)
				.attr("x", 0)
				.attr("opacity", 0)
				.remove();

			setTimeout(() => {
				// Fade in the demo_dots after bars transition out
				svg.selectAll('.demo_dot')
					.transition()  // Start a transition
					.duration(500)
					.style('opacity', 0.2)
					.style('pointer-events', 'auto')
				svg.selectAll('.demo_dot')
					.on("mouseenter", highlightTooltip)
					.on("mouseover", highlight)
					.on("mouseout", doNotHighlight);
			}, 200);

			// Reset the ad_name_replace element
			document.getElementById('ad_name_replace').innerHTML = '* Click on any dot to see the demographic breakdown of the audience for the selected ad, as well as a link to the ad.';
			document.querySelector('#demo-switch').style.pointerEvents = 'auto';
			document.querySelector('#demo-switch').style.opacity = 1;
			// Hide the button
			this.style.display = 'none';
		});

		if (cleanedData.length < 6500) {
			document.getElementById('ad_name_replace').innerHTML = '* Click on any dot to see the demographic breakdown of the audience for the selected ad, as well as a link to the ad.';
			document.querySelector('.demo_ad_exit_button').style.display = 'none';
			// Draw and style each of the dots
			svg.append('g')
				.selectAll('dot')
				.data(cleanedData)
				.enter()
				.append('circle')
					.attr('class', function (d) {return 'demo_dot ad_' + d.ad})
					.attr('cx', function(d) {return x(d.percentage)})
					.attr('cy', function(d) {return perturb(y(d.demographic), 12)})
					.attr('r', defaultRadius)
					.style('fill', color)
					.style('opacity', 0.2)
					.style('cursor', 'pointer')
					.on("mouseenter", highlightTooltip)
					.on("mouseover", highlight)
					.on("mouseout", doNotHighlight)
					.on("click", viewAd)
		} else {
			document.getElementById('ad_name_replace').innerHTML = '* More than 500 ads detected — the interactive plot has been replaced with a static violin chart. To explore data for this advertiser with the interactive plot, try shortening the date range by using the main Filter feature.';
			document.querySelector('.demo_ad_exit_button').style.display = 'none';
			// If there are too many dots, show a violin plot instead of dots
			// Create a histogram of x-axis frequencies
			var histogram = d3.histogram()
				.domain([0, 1])
				.thresholds(x.ticks(160))
				.value(d => d)

			// Create the nested statistics
			var numstat = d3.nest()
				.key(function(d) { return d.demographic;})
				.rollup(function(d) {   // For each key..
					input = d.map(function(g) { return g.percentage;})
					bins = histogram(input)   // And compute the binning on it.
					var lengths = bins.map(b => b.length)
					var maxLength = d3.max(lengths)
					return lengths.map((v, i) => {
						return {
							size: v / maxLength,
							start: i / lengths.length
						}
					})
				})
				.entries(cleanedData)

			// Draw the violins
			svg
				.selectAll("myViolin")
				.data(numstat)
				.enter()        // So now we are working group per group
				.append("g")
				.attr("transform", function(d){ return("translate(0, " + y(d.key) +")") } ) // Translation on the right to be at the group position
				.append("path")
					.style("fill", function(d) {
						if (d.key[0] == 'M') return colorSchemes.blue
						if (d.key[0] == 'W') return colorSchemes.green
						return '#F0A202'
					})
					.datum(function(d){ return(d.value)})
					.attr("d", d3.area()
						.y0(function(d){return(d.size * 10)} )
						.y1(function(d){return(-d.size * 10) } )
						.x(function(d){return(x(d.start)) } )
						   // This makes the line smoother to give the violin appearance. Try d3.curveStep to see the difference
					)

		}
		
		// boxplot height
		var boxHeight = 12

		// Calculate quartiles and median for each row
		var sumstat = d3.nest()
			.key(function(d) {return d.demographic})
			.rollup(function(d) {
				q1 = d3.quantile(d.map(function(g) { return g.percentage;}).sort(d3.ascending),.25)
				median = d3.quantile(d.map(function(g) { return g.percentage;}).sort(d3.ascending),.5)
				q3 = d3.quantile(d.map(function(g) { return g.percentage;}).sort(d3.ascending),.75)
				interQuantileRange = q3 - q1
				min = q1 - 1.5 * interQuantileRange
				max = q3 + 1.5 * interQuantileRange
				return({q1: q1, median: median, q3: q3, interQuantileRange: interQuantileRange, min: min, max: max})
			})
			.entries(cleanedData)

		// Draw the horizontal lines ("whiskers")
		var horizLines = svg.selectAll('horizLines')
			.data(sumstat)
			.enter()
			.append('line')
				.attr("y1", function(d){return y(d.key)})
				.attr("y2", function(d){return y(d.key)})
				.attr("x1", function(d){return x(d.value.min)})
				.attr("x1", function(d){return x(d.value.max)})
				.attr('stroke', 'black')
				.style('opacity', boxplot_check ? '1' : '0')
				.style('z-index', 10);

		// Draw the boxes
		var boxes = svg.selectAll('boxes')
			.data(sumstat)
			.enter()
			.append('rect')
				.attr('y', function(d){return(y(d.key) - boxHeight/2)})
				.attr('x', function(d){return(x(d.value.q1))})
				.attr('width', function(d){return(x(d.value.q3) - x(d.value.q1))})
				.attr('height', boxHeight)
				.attr('stroke', 'black')
				.attr('fill', 'transparent')
				.style('pointer-events', 'none')
				.style('opacity', boxplot_check ? '1' : '0')
				.style('z-index', 10);

		// Draw the median lines
		var medianLines = svg.selectAll('medianLines')
			.data(sumstat)
			.enter()
			.append('line')
				.attr('x1', function(d){return(x(d.value.median))})
				.attr('x2', function(d){return(x(d.value.median))})
				.attr('y1', function(d){return(y(d.key) - boxHeight/2)})
				.attr('y2', function(d){return(y(d.key) + boxHeight/2)})
				.attr('stroke', 'black')
				.style('opacity', boxplot_check ? '1' : '0')
				.style('z-index', 10);


		var switchInput = document.getElementById('original-switch-input');		
		// Add event listener to toggle boxplot visibility
		switchInput.addEventListener('change', function () {
			if (switchInput.checked) {
				boxplot_check = true;
				horizLines.transition().duration(200).style('opacity', '1');
				boxes.transition().duration(200).style('opacity', '1');
				medianLines.transition().duration(200).style('opacity', '1');
			} else {
				boxplot_check = false;
				horizLines.transition().duration(200).style('opacity', '0');
				boxes.transition().duration(200).style('opacity', '0');
				medianLines.transition().duration(200).style('opacity', '0');
			}
		});
		
		// Remove the loading indicator once the chart is finished
		d3.select('#demographics_loader').style('display', 'none')

		// Enable the close button
		d3.select("#close-right-col").style("pointer-events", "auto");
		d3.select("#close-right-col").style("opacity", "1");
	}

	// Need this because d3 wordcloud is just weird
	// Source: https://stackoverflow.com/questions/50222762/redrawing-word-cloud-with-d3-wordcloud
	function deepCopy(oldValue) { 
		var newValue
		strValue = JSON.stringify(oldValue)
		return newValue = JSON.parse(strValue)
	}

	function drawWordcloud(data) {
		d3.select("#new-wordcloud-test")
			.selectAll("svg")
			.remove();
			
		d3.select("#new-wordcloud-test")
			.style("height", '0px')
			.style("max-height", '0px')
			.selectAll("svg")
			.style("opacity", 0);
			
		d3.select('#wordmap_loader').style('display', 'block');
		d3.select('#wordmap-error').style('display', 'none');

		const wordcloudContainer = document.getElementById('new-wordcloud-test');
		
		d3.select('#wordmap_loader').style('display', 'none')
		const maxFontSize = d3.max(data, d => d.size);
		
		var fill = d3.scaleOrdinal(d3.schemeCategory10);

		var layout = d3.layout.cloud()
			.size([wordcloudContainer.offsetWidth, 300])
			.words(deepCopy(data))
			.padding(1)
			.rotate(function() {
				return (0);
			})
			.font("Open Sans")
			.fontSize(function(d) {
				return ((d.size/maxFontSize)*50)+10;
			})
			.on("end", draw);
		layout.start(); 
		
		
		d3.select("#new-wordcloud-test")
			.style("height", '300px')
			.style("max-height", '300px')

		function draw(words) {
			d3.select("#new-wordcloud-test").append("svg")
			.attr("width", layout.size()[0])
			.attr("height", layout.size()[1])
			.attr("style", "display: block; margin-left: auto; margin-right: auto; background: transparent; text-align: center;")
			.append("g")
			.attr("transform", "translate(" + layout.size()[0] / 2 + "," + layout.size()[1] / 2 + ")")
			.selectAll("text")
			.data(words)
			.enter().append("text")
			.style("font-size", function(d) { return (d.size) + "px"; })
			.style("font-family", "Open Sans")
			.style("fill", function(d, i) { return fill(i); })
			.attr("text-anchor", "middle")
			.attr("transform", function(d) {
				return "translate(" + [d.x, d.y] + ")rotate(" + d.rotate + ")";
			})
			.text(function(d) { return d.text; });
		} 
		
		d3.select("#new-wordcloud-test")
			.selectAll("svg")
			.style("opacity", 1);
	}

	function drawSummaryTable(data) {
		d3.select("#summary_loader").style('display', 'none');
		d3.select("#funder_summary").style('display', 'block');
		cloudTable.clear().draw();
		
		for (const row of data) {
			if (row.ad_content === "" || row.ad_content === null) {
				continue;
			} 
			
			const freqValue = row.ad_count; // Extract the numerical value
        	var freqObj = `${freqValue}`;
			var sampleAd = `<a style="cursor: pointer;" onclick="window.open('${row.ad_url}', '_blank')" data-value="Click to see a sample ad.">Sample ad <i class="fas fa-link"></i></a>`;
			let truncatedCreativeBodies = row.ad_content;

			// Add data to the DataTable
			cloudTable.row.add([
				truncatedCreativeBodies,
				freqObj,
				sampleAd
			]).draw(false);
		}
		cloudTable.draw(true);
	}

	if (isMobile) {
		mobileFormat = d3.timeFormat('%m/%d/%Y');
		d3.selectAll('.dropdown-timeframe')
			.html(`<i class="fas fa-calendar-alt"></i> ${mobileFormat(startDay)} - ${mobileFormat(end)}`);
	} else {
		d3.selectAll('.dropdown-timeframe')
			.html(`<i class="fas fa-calendar-alt"></i> ${format(startDay)} - ${format(end)}`);
	}

</script>

