		border-color: #fff #0000;
		animation: l16 1s infinite linear;
	}
	.filter-loader::before,
	.filter-loader::after {    
	content: "";
	grid-area: 1/1;
	margin: 2px;
	border: inherit;
	border-radius: 50%;
	}
	.filter-loader::before {
	border-color: #f03355 #0000;
	animation: inherit; 
	animation-duration: .5s;
	animation-direction: reverse;
	}
	.filter-loader::after {
	margin: 8px;
	}
	@keyframes l16 { 
	100%{transform: rotate(1turn)}
	}
