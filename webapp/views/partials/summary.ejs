	function updateFacebookTimestamps() {
		startDay = moment(fbStartDay, 'MM-DD-YYYY');
		end = moment(fbEndDay, 'MM-DD-YYYY');
		
		format = d3.timeFormat('%b %d, %Y');

		d3.selectAll('.facebook_date')
