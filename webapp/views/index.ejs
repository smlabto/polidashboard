    $("#filter_date_in, #filter_date_out").daterangepicker({
        dateFormat: 'MM dd, yy',
    	minDate: "10/10/2023",
        showOtherMonths: true
	});
	
	const numberOfDays = <%- days %>
	const urlParams = new URLSearchParams(window.location.search)
	const endDay = (urlParams.has('endDay')) ? urlParams.get('endDay') : 1
	
	var textStyle = {
		bold: false,
		fontSize: 10
	};
	let colorSchemes = {
		'blue' :		'#2276b4',
		'green' :		'#009966',
		'red' :			'#cd5c5c',
		'dark_blue' :	'#08485f',
		'blue_green' :	'#007277',
		'gray' :		'#aab6c7',
		'purple' :		'#75538a',
		'black' :		'#000000',
		'pink' :		'#e69696',
		'dark_green' :	'#05553b',
		'light_blue' :	'#a2c8e2',
	}
	colorSchemes.range = [
		colorSchemes.green, 
		colorSchemes.blue_green, 
		colorSchemes.dark_blue, 
		colorSchemes.purple, 
		colorSchemes.red
	]
	colorSchemes.discrete = [
		colorSchemes.green, 
		colorSchemes.blue, 
		colorSchemes.gray, 
		colorSchemes.red, 
		colorSchemes.dark_blue, 
		colorSchemes.blue_green, 
		colorSchemes.purple
	]

	var barOptions = {
		'height':400,
		'vAxis':{
			textStyle: textStyle,
			title: '',
		},
		bars: 'horizontal',
		'legend':{'position':'none'},
		'colors': colorSchemes.blue,
		chartArea: {width: '100%', height: '100%', left: '100%'},
		hAxis: {textPosition: 'in', bold: false},
		isStacked: true
	};
  </script>



